{
  "env": {
    "common": {},
    "linux": {
      "qt": {
        "description": "X11(xcb)互換モードおよびUI拡大率自動調整設定",
        "vars": {
          "QT_QPA_PLATFORM": "xcb",
          "QT_AUTO_SCREEN_SCALE_FACTOR": "1"
        }
      },
      "rusticl": {
        "description": "AMD / Intel GPU 用 RustiCL (OpenCL 3.0) 有効化設定 (使用する場合は vars 内に vars_example のキーと値を設定)",
        "vars": {},
        "vars_example": {
          "RUSTICL_ENABLE": "radeonsi,iris,nouveau",
          "OCL_ICD_VENDORS": "rusticl.icd"
        }
      },
      "python_path": {
        "description": "DaVinci Resolveが使用するPython3ライブラリの検索パス",
        "vars": {
          "PYTHONHOME": "${HOME}/.local/share/uv/python/cpython-3.10.11-linux-x86_64-gnu",
          "LD_LIBRARY_PATH": "${PYTHONHOME}/lib:${LD_LIBRARY_PATH}"
        }
      },
      "input_method": {
        "description": "日本語入力 (Fcitx5 / Mozc) 設定",
        "vars": {
          "GTK_IM_MODULE": "fcitx",
          "QT_IM_MODULE": "fcitx",
          "XMODIFIERS": "@im=fcitx"
        }
      }
    },
    "win": {},
    "mac": {}
  }
}
